{
    "id": "org.freedesktop.Platform.XWayland",
    "branch": "26.08",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm22"
    ],
    "build-extension": true,
    "separate-locales": false,
    "appstream-compose": false,
    "build-options": {
        "prefix": "/usr/lib/extensions/xwayland",
        "prepend-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/extensions/xwayland/bin",
        "prepend-ld-library-path": "/usr/lib/extensions/xwayland/lib",
        "prepend-pkg-config-path": "/usr/lib/extensions/xwayland/lib/pkgconfig"
    },
    "modules": [
        {
            "name": "xwayland-wrappers",
            "buildsystem": "simple",
            "build-commands": [
                "cc -O2 -o flatpak-xwayland-satellite-wrapper satellite.c",
                "cc -O2 -o flatpak-xwayland-run-wrapper run.c",
                "install -Dm755 flatpak-xwayland-satellite-wrapper -t ${FLATPAK_DEST}/bin/",
                "install -Dm755 flatpak-xwayland-run-wrapper -t ${FLATPAK_DEST}/bin/",
                "printf '#!/bin/sh\\nexit 0\\n' > xauth-stub && install -Dm755 xauth-stub ${FLATPAK_DEST}/bin/xauth"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "../xwayland-wrappers/satellite.c"
                },
                {
                    "type": "file",
                    "path": "../xwayland-wrappers/run.c"
                }
            ]
        },
        {
            "name": "xwayland-satellite",
            "buildsystem": "simple",
            "build-options": {
                "env": {
                    "CARGO_HOME": "/run/build/xwayland-satellite/cargo",
                    "LIBCLANG_PATH": "/usr/lib/sdk/llvm22/lib",
                    "BINDGEN_EXTRA_CLANG_ARGS": "-I/usr/lib/sdk/llvm22/lib/clang/22/include"
                },
                "append-path": "/usr/lib/sdk/rust-stable/bin"
            },
            "build-commands": [
                "cargo --offline fetch --manifest-path Cargo.toml --verbose",
                "cargo --offline build --release --verbose",
                "install -Dm755 target/release/xwayland-satellite -t ${FLATPAK_DEST}/bin/"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/Supreeeme/xwayland-satellite/archive/refs/tags/v0.8.3.tar.gz",
                    "sha256": "8b32873d7d740143ce9efa3cfb43c17d0176b89d2e8ffaa497db709f154fc478"
                },
                "xwayland-satellite-sources.json"
            ]
        },
        {
            "name": "libfontenc",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://xorg.freedesktop.org/archive/individual/lib/libfontenc-1.1.8.tar.xz",
                    "sha256": "7b02c3d405236e0d86806b1de9d6868fe60c313628b38350b032914aa4fd14c6"
                }
            ]
        },
        {
            "name": "libxfont2",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://xorg.freedesktop.org/archive/individual/lib/libXfont2-2.0.9.tar.xz",
                    "sha256": "f042a370666815e7b941e9b7019024755bd1c6c2954afbfa515af378251799e2"
                }
            ]
        },
        {
            "name": "font-util",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://xorg.freedesktop.org/archive/individual/font/font-util-1.4.1.tar.xz",
                    "sha256": "5c9f64123c194b150fee89049991687386e6ff36ef2af7b80ba53efaf368cc95"
                }
            ]
        },
        {
            "name": "libxcvt",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://xorg.freedesktop.org/archive/individual/lib/libxcvt-0.1.3.tar.xz",
                    "sha256": "a929998a8767de7dfa36d6da4751cdbeef34ed630714f2f4a767b351f2442e01"
                }
            ]
        },
        {
            "name": "xwayland",
            "buildsystem": "meson",
            "config-opts": [
                "-Dxvfb=false",
                "-Ddri3=true",
                "-Dglamor=true",
                "-Dsecure-rpc=false",
                "-Dsha1=libcrypto",
                "-Dxdmcp=false",
                "-Ddocs=false",
                "-Ddevel-docs=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://xorg.freedesktop.org/archive/individual/xserver/xwayland-24.1.6.tar.xz",
                    "sha256": "737e612ca36bbdf415a911644eb7592cf9389846847b47fa46dc705bd754d2d7"
                }
            ]
        },
        {
            "name": "xwayland-run",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.freedesktop.org/ofourdan/xwayland-run.git",
                    "tag": "0.0.6"
                }
            ]
        }
    ]
}
